{
  "name": "tx24-runoff-suite",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:playwright": "playwright test",
    "dev:admin": "pnpm --filter @tx24/admin dev",
    "dev:public": "pnpm --filter @tx24/public dev",
    "dev:api": "pnpm --filter @tx24/api dev",
    "dev:worker": "pnpm --filter @tx24/worker dev"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.54.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  }
}
